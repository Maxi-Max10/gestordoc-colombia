<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        id="manualDateDialog"
        title="Ingrese la fecha de Desahucio"
        contentWidth="auto"
        contentHeight="auto"
        class="responsiveDialog"
    >
        <VBox id="_IDGenVBox"
            width="auto"
            class="sapUiSmallMargin"
        >
            <DatePicker
                id="manualDatePicker"
                placeholder="Seleccione la fecha"
                width="100%"
            />
        </VBox>

        <buttons>
            <Button id="_IDGenButton4"
                text="Confirmar"
                type="Emphasized"
                press="onConfirmManualDate"
            />
            <Button id="_IDGenButton5"
                text="Cancelar"
                type="Reject"
                press="onCancelManualDate"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
