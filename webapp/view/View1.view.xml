<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:micro="sap.suite.ui.microchart"
    controllerName="gestordoccolombia.controller.View1"
>
    <Shell
        id="_IDGenShell"
        appWidthLimited="false"
    >
        <Page
            id="contentContainer"
            title="Categorias"
            showHeader="false"
        >
            <content>
                <core:Fragment
                    fragmentName="gestordoccolombia.view.Header"
                    type="XML"
                />

                <!-- ═══════════════════════════════════════════
                     BANNER DE BIENVENIDA
                ════════════════════════════════════════════ -->
                <VBox
                    id="_IDGenVBox1"
                    width="100%"
                    height="200px"
                    alignItems="Start"
                    justifyContent="Center"
                    class="imageContainer sapUiSmallMarginTop"
                >
                    <Text
                        id="greetingText"
                        text=""
                        class="greetingText"
                    />
                    <Text
                        text="Bienvenido al sistema de Gestión Documental."
                        class="bannerSubtitle"
                    />
                    <HBox
                        alignItems="Center"
                        class="bannerDateRow"
                    >
                        <core:Icon
                            src="sap-icon://calendar"
                            class="bannerDateIcon"
                        />
                        <Text
                            id="bannerDateText"
                            text=""
                            class="bannerDateText"
                        />
                    </HBox>
                </VBox>

                <!-- ═══════════════════════════════════════════
                     ENCABEZADO DE SECCIÓN + BÚSQUEDA
                ════════════════════════════════════════════ -->
                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="documentsHeader"
                >
                    <Title
                        id="_IDGenTitle"
                        text="Gestión de Documentos"
                        titleStyle="H4"
                        textAlign="Left"
                        class="sectionTitle"
                    />
                    <SearchField
                        id="documentSearch"
                        width="24rem"
                        placeholder="Buscar documentos"
                        liveChange="onDocumentSearch"
                        search="onDocumentSearch"
                        class="documentSearchField"
                    />
                </HBox>

                <!-- ═══════════════════════════════════════════
                     GRID DE TARJETAS DE DOCUMENTOS
                     Convención de colores (uno por card):
                       red    · orange · yellow
                       green  · teal   · blue
                       purple · pink   · gray
                       indigo · brown  · lime
                ════════════════════════════════════════════ -->
                <sap.ui.layout:Grid
                    xmlns:sap.ui.layout="sap.ui.layout"
                    id="gridItems"
                    width="100%"
                    defaultSpan="XL3 L3 M6 S12"
                    hSpacing="1"
                    vSpacing="1"
                    position="Left"
                    class="customGrid"
                >
                    <sap.ui.layout:content>

                        <!-- 1. KIT DE RETIRO  ── color: red         LISTO -->
                        <CustomListItem
                            id="customListItemKitRetiro"
                            class="customListItem card-horizontal card-red"
                            type="Active"
                            press="onKitRetiroPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://employee-rejections" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text id="_IDGenTextKitRetiro" text="Kit de Retiro" class="card-title" />
                                    <Text text="Gestionar documentos de retiro" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 2. COMPROMISO CON LA ÉTICA  ── color: blue -->
                        <CustomListItem
                            id="customListItemCompromisoEtica"
                            class="customListItem card-horizontal card-blue"
                            type="Active"
                            press="onCompromisoEticaPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://signature" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Compromiso con la Ética" class="card-title" />
                                    <Text text="Declaración de principios éticos" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 3. AUTORIZACIÓN DE DATOS PERSONALES  ── color: teal -->
                        <CustomListItem
                            id="customListItemDatosPersonales"
                            class="customListItem card-horizontal card-teal"
                            type="Active"
                            press="onDatosPersonalesPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://private" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Autorización Datos Personales" class="card-title" />
                                    <Text text="Gestión de política de datos" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 4. PROTOCOLO DE RECIBO REGLAMENTO INTERNO  ── color: gray -->
                        <CustomListItem
                            id="customListItemProtocoloRecibo"
                            class="customListItem card-horizontal card-gray"
                            type="Active"
                            press="onProtocoloReciboPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://official-service" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Protocolo Reglamento Interno" class="card-title" />
                                    <Text text="Recibo de reglamento interno" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 5. MANIFESTACIÓN DE NO DECLARANTE  ── color: pink -->
                        <CustomListItem
                            id="customListItemNoDeclarante"
                            class="customListItem card-horizontal card-pink"
                            type="Active"
                            press="onNoDeclarantePress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://survey" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Manifestación No Declarante" class="card-title" />
                                    <Text text="Declaración tributaria" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 6. AUTORIZACIÓN DE DESCUENTO  ── color: purple -->
                        <CustomListItem
                            id="customListItemAutorizacionDescuento"
                            class="customListItem card-horizontal card-purple"
                            type="Active"
                            press="onAutorizacionDescuentoPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://money-bills" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Autorización de Descuento" class="card-title" />
                                    <Text text="Gestión de deducciones" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 7. DEDUCCIONES DE RETENCIÓN  ── color: indigo         LISTO -->        
                        <CustomListItem
                            id="customListItemSolicitudDeduccionesRetencion"
                            class="customListItem card-horizontal card-indigo"
                            type="Active"
                            press="onDeduccionesPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://expense-report" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Deducciones de Retención" class="card-title" />
                                    <Text text="Solicitud de retenciones" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 8. BENEFICIOS EXTRALEGALES  ── color: orange         LISTO -->
                        <CustomListItem
                            id="customListItemBeneficios"
                            class="customListItem card-horizontal card-orange"
                            type="Active"
                            press="onBeneficiosExtralegalesPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://collections-insight" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Beneficios Extralegales" class="card-title" />
                                    <Text text="Declaración política de beneficios" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 9. CONTRATO A TÉRMINO FIJO  ── color: green -->
                        <CustomListItem
                            id="customListItemContratoTerminoFijo"
                            class="customListItem card-horizontal card-green"
                            type="Active"
                            press="onContratoTerminoFijoPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://business-card" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Contrato Término Fijo" class="card-title" />
                                    <Text text="Documentación contrato fijo" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 10. CONTRATO A TÉRMINO INDEFINIDO  ── color: brown -->
                        <CustomListItem
                            id="customListItemContratoTerminoIndef"
                            class="customListItem card-horizontal card-brown"
                            type="Active"
                            press="onContratoIndefinidoPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://hr-approval" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Contrato Término Indefinido" class="card-title" />
                                    <Text text="Documentación contrato indefinido" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 11. APRENDIZAJE ETAPA LECTIVA  ── color: lime -->
                        <CustomListItem
                            id="customListItemContratoAprendizajeLectivo"
                            class="customListItem card-horizontal card-lime"
                            type="Active"
                            press="onContratoAprendizajeLectivoPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://education" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Aprendizaje Etapa Lectiva" class="card-title" />
                                    <Text text="Contrato de aprendizaje lectivo" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 12. APRENDIZAJE ETAPA PRODUCTIVA  ── color: blue -->
                        <CustomListItem
                            id="customListItemContratoAprendizajeProductivo"
                            class="customListItem card-horizontal card-cyan"
                            type="Active"
                            press="onContratoAprendizajeProductivoPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://work-history" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Aprendizaje Etapa Productiva" class="card-title" />
                                    <Text text="Contrato de aprendizaje productivo" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 13. CONTRATO INDEFINIDO INTEGRAL  ── color: purple -->
                        <CustomListItem
                            id="customListItemContratoIntegral"
                            class="customListItem card-horizontal card-violet"
                            type="Active"
                            press="onContratoIntegralPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://documents" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Contrato Indefinido Integral" class="card-title" />
                                    <Text text="Documentación contrato integral" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 14. OTRO SÍ - ALIMENTACIÓN 10.000  ── color: orange         LISTO -->
                        <CustomListItem
                            id="customListItemOtroSiAlimentacion10"
                            class="customListItem card-horizontal card-amber"
                            type="Active"
                            press="onOtroSiAlimentacion10Press"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://meal" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Otro Sí - Alim. $10.000" class="card-title" />
                                    <Text text="Modificación contrato alimentación" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 15. OTRO SÍ - ALIMENTACIÓN 11.500  ── color: pink         LISTO -->
                        <CustomListItem
                            id="customListItemOtroSiAlimentacion11"
                            class="customListItem card-horizontal card-rose"
                            type="Active"
                            press="onOtroSiAlimentacion11Press"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://basket" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Otro Sí - Alim. $11.500" class="card-title" />
                                    <Text text="Modificación contrato alimentación" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 16. OTRO SÍ - ALIMENTACIÓN 15.000  ── color: teal         LISTO -->
                        <CustomListItem
                            id="customListItemOtroSiAlimentacion15"
                            class="customListItem card-horizontal card-emerald"
                            type="Active"
                            press="onOtroSiAlimentacion15Press"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://fridge" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Otro Sí - Alim. $15.000" class="card-title" />
                                    <Text text="Modificación contrato alimentación" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <!-- 17. OTRO SÍ - RODAMIENTO  ── color: blue         LISTO -->
                        <CustomListItem
                            id="customListItemOtroSiRodamiento"
                            class="customListItem card-horizontal card-sky"
                            type="Active"
                            press="onOtroSiRodamientoPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box">
                                    <core:Icon src="sap-icon://car-rental" class="card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text text="Otro Sí - Rodamiento" class="card-title" />
                                    <Text text="Auxilio de rodamiento" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow" />
                                </VBox>
                            </HBox>
                        </CustomListItem>

                    </sap.ui.layout:content>
                </sap.ui.layout:Grid>

                <!-- ═══════════════════════════════════════════
                     DIÁLOGO DE SELECCIÓN DE COLABORADORES
                ════════════════════════════════════════════ -->
                <Dialog
                    id="employeeDialog"
                    title=""
                    beforeOpen="onBeforeOpenDialog"
                    afterOpen="onAfterOpenDialog"
                    afterClose="onAfterCloseDialog"
                    contentWidth="58rem"
                    contentHeight="auto"
                    class="responsiveDialog employeeDialog"
                >
                    <customHeader>
                        <Toolbar class="employeeDialogHeader">
                            <HBox alignItems="Center" class="employeeDialogHeaderInfo">
                                <VBox id="employeeDialogIconBadge" alignItems="Center" justifyContent="Center" class="employeeDialogIconBadge">
                                    <core:Icon src="{view>/DialogIcon}" class="employeeDialogHeaderIcon" />
                                </VBox>
                                <VBox justifyContent="Center" class="employeeDialogTitleBlock">
                                    <Title
                                        text="{view>/DialogTitle}"
                                        titleStyle="H5"
                                        class="employeeDialogTitle"
                                    />
                                    <Text
                                        text="Seleccione colaboradores para generar los documentos correspondientes."
                                        class="employeeDialogSubtitle"
                                    />
                                </VBox>
                            </HBox>
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://decline"
                                press="onCloseDialog"
                                type="Transparent"
                                class="employeeDialogCloseButton"
                            />
                        </Toolbar>
                    </customHeader>

                    <VBox
                        id="_IDGenVBox10"
                        class="dialogContainer"
                        width="100%"
                    >
                        <!-- Filtros del diálogo -->
                        <HBox
                            id="_IDGenOverflowToolbar"
                            width="100%"
                            alignItems="Center"
                            class="employeeFilterBar"
                        >
                            <SearchField
                                id="searchField"
                                liveChange="onSearchFieldChange"
                                width="100%"
                                placeholder="Buscar por ID, colaborador o documento..."
                                class="employeeSearchField"
                            />
                            <DateRangeSelection
                                id="dateRange"
                                width="16rem"
                                change="onDateFilterChange"
                                placeholder="Filtrar por fecha"
                                class="employeeDateRange"
                            />
                        </HBox>

                        <!-- Tabla de colaboradores -->
                        <Table
                            id="idUserTable"
                            class="customTable"
                            growing="true"
                            growingThreshold="40"
                            growingScrollToLoad="false"
                            growingTriggerText="Cargar más"
                            selectionChange="onSelectionChange"
                            inset="false"
                            mode="MultiSelect"
                            items="{ path: 'view>/FilteredUsers', sorter: { path: 'lastName' } }"
                        >
                            <columns>
                                <Column id="_IDGenColumn1" width="20%">
                                    <Text id="_IDGenText" text="ID" />
                                </Column>
                                <Column id="_IDGenColumn2" width="50%">
                                    <Text id="_IDGenText1" text="Colaborador" />
                                </Column>
                                <Column id="_IDGenColumn3" width="30%" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                    <Text id="_IDGenText2" text="Documento" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="_IDGenColumnListItem">
                                    <cells>
                                        <Text id="_IDGenText3" text="{view>customLong1}" />
                                        <Text id="_IDGenText4" text="{view>firstName} {view>lastName}" />
                                        <Text id="_IDGenText6" text="{view>nationalId}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <buttons>
                        <Button
                            id="wordDataInfo"
                            text="Generar Word"
                            icon="sap-icon://doc-attachment"
                            tooltip="Generar Word"
                            press="onDownloadPDF"
                            class="wordButtonCustom"
                            type="Emphasized"
                        />
                        <Button
                            id="pdfDataInfo"
                            text="Generar PDF"
                            icon="sap-icon://pdf-attachment"
                            tooltip="Generar PDF"
                            press="onDownloadPDF"
                            class="pdfButtonCustom"
                            type="Accept"
                        />
                        <Button
                            id="docusignDataInfo"
                            text="Enviar a DocuSign"
                            icon="sap-icon://signature"
                            visible="{view>/ShowDocuSignButton}"
