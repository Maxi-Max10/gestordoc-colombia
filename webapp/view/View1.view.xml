<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    xmlns:micro="sap.suite.ui.microchart"
    controllerName="gestordoccolombia.controller.View1"
>
    <Shell
        id="_IDGenShell"
        appWidthLimited="false"
    >
        <Page
            id="contentContainer"
            title="Categorias"
            showHeader="false"
        >
            <content>
                <core:Fragment
                    fragmentName="gestordoccolombia.view.Header"
                    type="XML"
                />
                <VBox
                    id="_IDGenVBox1"
                    width="100%"
                    height="200px"
                    alignItems="Start"
                    justifyContent="Center"
                    class="imageContainer sapUiSmallMarginTop"
                >
                    <Text
                        id="greetingText"
                        text=""
                        class="greetingText"
                    />
                    <Text
                        text="Bienvenido al sistema de Gestión Documental."
                        class="bannerSubtitle"
                    />
                    <HBox
                        alignItems="Center"
                        class="bannerDateRow"
                    >
                        <core:Icon
                            src="sap-icon://calendar"
                            class="bannerDateIcon"
                        />
                        <Text
                            id="bannerDateText"
                            text=""
                            class="bannerDateText"
                        />
                    </HBox>
                </VBox>
                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="documentsHeader"
                >
                    <Title
                        id="_IDGenTitle"
                        text="Gestión de Documentos"
                        titleStyle="H4"
                        textAlign="Left"
                        class="sectionTitle"
                    />
                    <SearchField
                        id="documentSearch"
                        width="24rem"
                        placeholder="Buscar documentos"
                        liveChange="onDocumentSearch"
                        search="onDocumentSearch"
                        class="documentSearchField"
                    />
                </HBox>
                <sap.ui.layout:Grid
                    xmlns:sap.ui.layout="sap.ui.layout"
                    id="gridItems"
                    width="100%"
                    defaultSpan="XL3 L3 M6 S12"
                    hSpacing="1"
                    vSpacing="1"
                    position="Left"
                    class="customGrid"
                >
                <!-- botones para usuarios. -->
                    <sap.ui.layout:content>
                        <CustomListItem
                            id="customListItemcartaMensualUsuario"
                            class="customListItem card-horizontal blue"
                            press="onDownloadCartaMensualUsuario"
                            type="Active"
                            visible="false"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box blue">
                                    <core:Icon
                                        id="_IDGenIcon21"
                                        src="sap-icon://document-text"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenText20"
                                        text="Cartas - Trabajo Mensual"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar cartas de trabajo mensual"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem
                            id="customListItemCartaAnualUsuario"
                            class="customListItem card-horizontal gray"
                            press="onDownloadCartaAnualUsuario"
                            visible="false"
                            type="Active"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box gray">
                                    <core:Icon
                                        id="_IDGenIcon22"
                                        src="sap-icon://calendar"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenTex21"
                                        text="Cartas - Trabajo Anual"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar cartas de trabajo anual"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <!-- 

                            <CustomListItem id="customListItemCertificado" class="customListItem pink">
                                <VBox id="_IDGenVBox3" alignItems="Center" justifyContent="Center" class="interactiveBox">
                                    <core:Icon id="_IDGenIcon1" src="sap-icon://employee" class="customIcon" />
                                    <Text id="_IDGenText6" text="Certificado Laboral" class="customText" />
                                </VBox>
                            </CustomListItem>-->

                        <CustomListItem
                            id="customListItemConfidencialidad"
                            class="customListItem card-horizontal"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box blue">
                                    <core:Icon
                                        id="_IDGenIcon2"
                                        src="sap-icon://locked"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenText7"
                                        text="Confidencialidad"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar documentos confidenciales"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <CustomListItem
                            id="customListItemContrato"
                            class="customListItem card-horizontal pink"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box pink">
                                    <core:Icon
                                        id="_IDGenIcon3"
                                        src="sap-icon://signature"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenText8"
                                        text="Contrato De Trabajo"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar contratos de trabajo"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <!--
                            <CustomListItem id="customListItemPasantes" class="customListItem skyblue">
                                <VBox id="_IDGenVBox8" alignItems="Center" justifyContent="Center" class="interactiveBox">
                                    <core:Icon id="_IDGenIcon6" src="sap-icon://education" class="customIcon" />
                                    <Text id="_IDGenText11" text="Contrato Pasantes" class="customText" />
                                </VBox>
                            </CustomListItem>

                          <CustomListItem id="customListItemTemporeros" class="customListItem orange">
                                <VBox id="_IDGenVBox9" alignItems="Center" justifyContent="Center" class="interactiveBox">
                                    <core:Icon id="_IDGenIcon7" src="sap-icon://calendar" class="customIcon" />
                                    <Text id="_IDGenText12" text="Contrato Temporeros" class="customText" />
                                </VBox>
                            </CustomListItem> -->

                        <CustomListItem
                            id="customCertificadoEx"
                            class="customListItem card-horizontal teal"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box teal">
                                    <core:Icon
                                        id="_IDGenIcon10"
                                        src="sap-icon://employee-approvals"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenText101"
                                        text="Certificado Laboral Excolaborador"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar certificados laborales"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem id="customListItemSalida" class="customListItem card-horizontal purple" visible="true">
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box purple">
                                    <core:Icon id="_IDGenIcon4" src="sap-icon://business-card" class="customIcon card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text id="_IDGenText9" text="Notificación Salida Ministerio" class="card-title" />
                                    <Text text="Gestionar notificaciones de salida" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem id="customListItemCartasM" class="customListItem card-horizontal gray" visible="true">
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box gray">
                                    <core:Icon id="_IDGenIcon5" src="sap-icon://document-text" class="customIcon card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text id="_IDGenText10" text="Cartas de Trabajo Mensual" class="card-title" />
                                    <Text text="Gestionar cartas de trabajo mensual" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem
                            id="customListItemDeshausio"
                            class="customListItem card-horizontal blue"
                            type="Active"
                            press="onDesahucioPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box blue">
                                    <core:Icon
                                        id="_IDGenIcon11"
                                        src="sap-icon://outgoing-call"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenText11"
                                        text="Carta Desahucio"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar cartas de desahucio"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem id="customListItemCartasA" class="customListItem card-horizontal pink" visible="true">
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box pink">
                                    <core:Icon id="_IDGenIcon" src="sap-icon://calendar" class="customIcon card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text id="_IDGenText5" text="Cartas De Trabajo Anual" class="card-title" />
                                    <Text text="Gestionar cartas de trabajo anual" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem id="customListItemAmonestacion" class="customListItem card-horizontal teal" visible="true">
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box teal">
                                    <core:Icon id="_IDGenIcon6" src="sap-icon://education" class="customIcon card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text id="_IDGenText12" text="Notificación De Amonestación" class="card-title" />
                                    <Text text="Gestionar notificaciones de amonestación" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                        <CustomListItem id="customListItemAuseInjus" class="customListItem card-horizontal purple" type="Active"
                            press="onAusenciaInjustificadaPress" visible="true">
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box purple">
                                    <core:Icon id="_IDGenIcon13" src="sap-icon://away" class="customIcon card-icon" />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text id="_IDGenText13" text="Notificación De Ausencia Injustificada" class="card-title" />
                                    <Text text="Gestionar notificaciones de ausencia" class="card-desc" />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>

                        <CustomListItem
                            id="customListItemKitRetiro"
                            class="customListItem card-horizontal orange"
                            type="Active"
                            press="onKitRetiroPress"
                            visible="true"
                        >
                            <HBox width="100%" height="100%" class="card-hbox">
                                <VBox width="80px" height="100%" class="card-icon-box orange">
                                    <core:Icon
                                        id="_IDGenIconKitRetiro"
                                        src="sap-icon://physical-activity"
                                        class="customIcon card-icon"
                                    />
                                </VBox>
                                <VBox width="auto" height="100%" class="card-content-box">
                                    <Text
                                        id="_IDGenTextKitRetiro"
                                        text="Kit De Retiro"
                                        class="card-title"
                                    />
                                    <Text
                                        text="Gestionar documentos de retiro"
                                        class="card-desc"
                                    />
                                </VBox>
                                <VBox width="24px" height="100%" justifyContent="Center" alignItems="End" class="card-arrow-box">
                                    <core:Icon src="sap-icon://navigation-right-arrow" class="card-arrow"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>

                    </sap.ui.layout:content>
                </sap.ui.layout:Grid>

                
                <!-- DIALOG -->
                <Dialog
                    id="employeeDialog"
                    title=""
                    beforeOpen="onBeforeOpenDialog"
                    afterOpen="onAfterOpenDialog"
                    afterClose="onAfterCloseDialog"
                    contentWidth="58rem"
                    contentHeight="auto"
                    class="responsiveDialog employeeDialog"
                >
                    <customHeader>
                        <Toolbar class="employeeDialogHeader">
                            <HBox alignItems="Center" class="employeeDialogHeaderInfo">
                                <VBox alignItems="Center" justifyContent="Center" class="employeeDialogIconBadge">
                                    <core:Icon src="sap-icon://document-text" class="employeeDialogHeaderIcon" />
                                </VBox>
                                <VBox justifyContent="Center" class="employeeDialogTitleBlock">
                                    <Title
                                        text="{view>/DialogTitle}"
                                        titleStyle="H5"
                                        class="employeeDialogTitle"
                                    />
                                    <Text
                                        text="Seleccione colaboradores para generar los documentos correspondientes."
                                        class="employeeDialogSubtitle"
                                    />
                                </VBox>
                            </HBox>
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://decline"
                                press="onCloseDialog"
                                type="Transparent"
                                class="employeeDialogCloseButton"
                            />
                        </Toolbar>
                    </customHeader>
                    <VBox
                        id="_IDGenVBox10"
                        class="dialogContainer"
                        width="100%"
                    >
                        <HBox
                            id="_IDGenOverflowToolbar"
                            width="100%"
                            alignItems="Center"
                            class="employeeFilterBar"
                        >
                            <SearchField
                                id="searchField"
                                liveChange="onSearchFieldChange"
                                width="100%"
                                placeholder="Buscar por ID, colaborador o documento..."
                                class="employeeSearchField"
                            />
                            <DateRangeSelection
                                id="dateRange"
                                width="16rem"
                                change="onDateFilterChange"
                                placeholder="Filtrar por fecha"
                                class="employeeDateRange"
                            />
                        </HBox>
                        <!-- TABLA -->
                        <Table
                            id="idUserTable"
                            class="customTable"
                            growing="true"
                            growingThreshold="40"
                            growingScrollToLoad="false"
                            growingTriggerText="Cargar más"
                            selectionChange="onSelectionChange"
                            
                            inset="false"
                            mode="MultiSelect"
                            items="{ path: 'view>/FilteredUsers', sorter: { path: 'lastName' } }"
                        >
                            <columns>
                                 <Column id="_IDGenColumn1" width="20%">
                                    <Text id="_IDGenText" text="ID" />
                                </Column>
                                <Column id="_IDGenColumn2" width="50%">
                                    <Text id="_IDGenText1" text="Colaborador" />
                                </Column>
                                <Column id="_IDGenColumn3" width="30%" minScreenWidth="Tablet" demandPopin="true">
                                    <Text id="_IDGenText2" text="Documento" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="_IDGenColumnListItem">
                                    <cells>
                                    <Text id="_IDGenText3" text="{view>customLong1}" />
                                    <Text id="_IDGenText4" text="{view>firstName} {view>lastName}" />
                                    <Text id="_IDGenText6" text="{view>nationalId}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>

                    <buttons>
                        <Button
                            id="wordDataInfo"
                            text="Generar Word"
                            icon="sap-icon://doc-attachment"
                            press="onDownloadPDF"
                            class="wordButtonCustom"
                            type="Emphasized"
                        />
                        <Button
                            id="pdfDataInfo"
                            text="Generar PDF"
                            icon="sap-icon://pdf-attachment"
                            press="onDownloadPDF"
                            class="pdfButtonCustom"
                            type="Accept"
                        />
                        <Button
                            id="_IDGenButton2"
                            text="Cancelar"
                            icon="sap-icon://decline"
                            press="onCloseDialog"
                            class="dialogCancelButton"
                            type="Default"
                        />
                    </buttons>
                </Dialog>
            </content>
        </Page>
    </Shell>
</mvc:View>
